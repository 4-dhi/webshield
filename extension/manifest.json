{
  "manifest_version": 3,
  "name": "WebShield.AI",
  "description": "Helps you to avoid accessing malicious websites by analyzing the website.",
  "version": "1.2",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon.png",
      "64": "icon.png",
      "96": "icon.png",
      "256": "icon.png"
    }
  },
  "icons": {
    "32": "icon.png",
    "64": "icon.png",
    "96": "icon.png",
    "256": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "https://your-app-name.onrender.com/"]
}

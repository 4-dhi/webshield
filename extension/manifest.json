{
  "manifest_version": 3,
  "name": "WebShield.AI",
  "description": "Enterprise-grade ad blocker with phishing detection, tracker blocking, and privacy protection.",
  "version": "3.0.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "scripting",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content.js",
        "cosmetic.js",
        "youtube.js",
        "antiadblock.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "ruleset_platform",
        "enabled": true,
        "path": "rules-platform.json"
      },
      {
        "id": "ruleset_security",
        "enabled": true,
        "path": "rules-security.json"
      },
      {
        "id": "ruleset_youtube",
        "enabled": false,
        "path": "rules-youtube.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webshield-ai@webshield.ai",
      "strict_min_version": "109.0"
    }
  }
}

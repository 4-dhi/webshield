{
  "manifest_version": 3,
  "name": "WebShield.AI",
  "description": "Automatically detects phishing websites as you browse.",
  "version": "2.1",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon.png",
      "64": "icon.png",
      "96": "icon.png",
      "256": "icon.png"
    }
  },
  "icons": {
    "32": "icon.png",
    "64": "icon.png",
    "96": "icon.png",
    "256": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": ["activeTab", "tabs", "webNavigation", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
